{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": "out/renderer",
  "rewrites": [
    {
      "source": "/:path",
      "destination": "/index.html"
    },
    {
      "source": "/api/health",
      "destination": "https://splayer-api.workers.dev/api/health"
    },
    {
      "source": "/api/login/*",
      "destination": "https://splayer-api.workers.dev/api/login/*"
    },
    {
      "source": "/api/*",
      "destination": "https://splayer-api.workers.dev/api/*"
    }
  ]
}
